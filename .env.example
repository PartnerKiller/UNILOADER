# Universal Downloader Environment Configuration
PORT=3000

# Optional: Spotify Developer API Credentials (for Spotify track/playlist metadata extraction)
# Create a free app at https://developer.spotify.com/dashboard to obtain Client ID & Secret
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional: Deezer HiFi ARL (for authentic 1411 kbps FLAC streaming)
# Obtain from browser cookies on deezer.com when logged into a HiFi account (cookie: 'arl')
DEEZER_ARL=your_deezer_arl_cookie_here

# Optional: Soulseek P2P Daemon (SLSKD API endpoint for audiophile FLAC masters)
# Defaults to http://127.0.0.1:5030/api/v0 if unset
SLSKD_API_BASE=http://127.0.0.1:5030/api/v0

