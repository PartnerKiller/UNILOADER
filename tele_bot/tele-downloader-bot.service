[Unit]
Description=Universal Downloader Telegram Bot Service
After=network-online.target jav-downloader.service
Wants=network-online.target jav-downloader.service

[Service]
Type=simple
User=sakura
Group=sakura
WorkingDirectory=/home/sakura/Uniloader/tele_bot
ExecStart=/usr/bin/python3 -u bot.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
