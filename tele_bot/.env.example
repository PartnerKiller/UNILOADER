# ========================================================
# Universal Downloader - Telegram Bot Configuration
# ========================================================

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=your_bot_token_here

# Authorized Telegram User IDs (comma-separated).
# If empty, any user can use the bot (NOT recommended).
ALLOWED_USERS=

# Downloader Backend Server URL
BACKEND_URL=http://127.0.0.1:3050

# Admin credentials for full owner permissions on backend
BACKEND_ADMIN_USER=sakura
BACKEND_ADMIN_PASS=Sakura@002

# Temp media directory where backend saves downloads
TEMP_DIR=/home/sakura/jav/temp_media

# Maximum file size (in MB) to attempt direct Telegram Bot upload (Telegram Bot API limit is 50MB)
MAX_TELEGRAM_UPLOAD_MB=50
